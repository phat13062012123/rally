rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid;
      // Chủ trận cập nhật currentPlayers khi duyệt yêu cầu.
      allow update: if signedIn() &&
        (resource.data.hostId == request.auth.uid || resource.data.hostUid == request.auth.uid);
    }

    match /matchRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.playerId == request.auth.uid || resource.data.hostId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.playerId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.hostId == request.auth.uid &&
        resource.data.status == 'pending' &&
        (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      // Người gửi chỉ được tạo thông báo dưới danh tính của chính mình.
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'handled']);
    }
  }
}
