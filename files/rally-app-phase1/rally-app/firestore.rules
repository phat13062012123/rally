rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid;
      // Chủ trận cập nhật currentPlayers khi duyệt yêu cầu.
      allow update: if signedIn() &&
        (resource.data.hostId == request.auth.uid || resource.data.hostUid == request.auth.uid);
    }

    match /matchRequests/{requestId} {
      // Client cần get document ID xác định trước trong transaction để kiểm tra
      // yêu cầu trùng. Khi document chưa tồn tại, resource.data chưa có
      // playerId/hostId nên không thể dùng rule list bên dưới cho thao tác get.
      allow get: if signedIn();
      allow list: if signedIn() &&
        (resource.data.playerId == request.auth.uid || resource.data.hostId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.playerId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.hostId == request.auth.uid &&
        resource.data.status == 'pending' &&
        (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      // Người gửi chỉ được tạo thông báo dưới danh tính của chính mình.
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'handled']);
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      // Chat được tạo khi người chơi gửi yêu cầu tham gia.
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds &&
        request.resource.data.participantIds == resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
